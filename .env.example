# OpenAI-compatible endpoint used by the interactive examples.
FEROX_BASE_URL=http://localhost:8080/v1
# Optional. Leave unset for providers that do not require authentication.
FEROX_API_KEY=

# Live endpoint and model used by the opt-in e2e tests.
FEROX_E2E_BASE_URL=http://localhost:8080/v1
FEROX_E2E_MODEL=your-model-id
# Optional. Leave unset for providers that do not require authentication.
FEROX_E2E_API_KEY=
